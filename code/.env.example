# AestheticLens-AI 服务端环境变量配置示例

# 阿里云百炼 API-KEY (用于后续多模态大模型真实调用)
DASHSCOPE_API_KEY=sk-placeholder_your_dashscope_key_here

# JWT 鉴权密钥 (使用 openssl rand -hex 32 生成，严禁硬编码提交至仓库)
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32_please

# 服务监听端口
PORT=8000

# 运行环境: development | production | test
ENVIRONMENT=development
